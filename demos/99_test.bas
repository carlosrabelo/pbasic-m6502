10 REM PBasic Comprehensive Regression Test
20 LET A = 10
30 LET B = A + 15
40 PRINT "B IS: "; B
50 IF B = 25 THEN GOSUB 200
60 LET C = -15
70 PRINT "NEG FIFTEEN IS: "; C
80 PRINT "ABS OF -15 IS: "; ABS(C)
90 LET R = RND(10)
100 PRINT "RANDOM VAL: "; R
110 FREE
120 GOTO 300
200 REM Subroutine target
210 PRINT "IN SUBROUTINE!"
220 RETURN
300 REM End of test
310 PRINT "--- TEST COMPLETE ---"
320 END
RUN
EXIT
