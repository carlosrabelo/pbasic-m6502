10 REM Arithmetic and Math Demo
20 PRINT "--- PBasic Arithmetic Demo ---"
30 LET A = 120
40 LET B = 35
50 PRINT "A = "; A
60 PRINT "B = "; B
70 PRINT "A + B = "; A + B
80 PRINT "A - B = "; A - B
90 PRINT "A * B = "; A * B
100 PRINT "A / B = "; A / B
110 LET C = -50
120 PRINT "C = "; C
130 PRINT "ABS(C) = "; ABS(C)
140 PRINT "RND(100) = "; RND(100)
150 END
